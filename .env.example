# Points to the project-specific config repo that holds config, secrets, and all data
PROJECT_CONFIG_DIR=/path/to/project-lens-seedsigner-config

# Database and clones live in the config repo's var/ directory
DATABASE_URL=sqlite+aiosqlite:////path/to/project-lens-seedsigner-config/var/project-lens.db
CLONES_DIR=/path/to/project-lens-seedsigner-config/var/clones

# Project config filename within the config directory
PROJECT_CONFIG_FILE=config.yaml

DEBUG=true

# GitHub personal access token (fine-grained, public repos read-only)
GITHUB_TOKEN=

# Telegram bot token (from @BotFather) and chat ID of the dev group
# The bot must be a member of the group. Chat IDs for groups are negative.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram messages go in a separate DB so they can be selectively shared.
# Defaults to telegram.db alongside the main database if not set.
# TELEGRAM_DATABASE_URL=sqlite+aiosqlite:////path/to/config-repo/var/telegram.db

# Project Lens configuration
#
# This file belongs in the PROJECT CONFIG repo (not the tool repo).
# All scripts accept --config-dir /path/to/config-repo which loads
# this .env and derives all paths from the config directory.
#
# Alternatively, set PROJECT_CONFIG_DIR as an environment variable.

# Project config filename within the config directory
PROJECT_CONFIG_FILE=config.yaml

# Secrets
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (derived automatically from config dir if not set)
# DATABASE_URL=sqlite+aiosqlite:///var/project-lens.db
# CLONES_DIR=var/clones
# TELEGRAM_DATABASE_URL=sqlite+aiosqlite:///var/telegram.db
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# CHROMA_DIR=var/chroma

DEBUG=false
